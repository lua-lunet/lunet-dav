# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lunet_dav
PGUSER=postgres
PGPASSWORD=change-me

# Secret used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# S3 object store for DAV file bytes (required; MinIO locally — see
# .env.dav.example for the full annotated set and e2e/e2e.env for e2e values)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=lunet-dav
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
