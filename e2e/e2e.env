# Environment for the automated e2e stack (e2e/docker-compose.yml).
# Everything is high-port and loopback-only; safe to run alongside dev services.
# This file is exported wholesale (set -a) by e2e/run-e2e.sh — unlike `make start`,
# which sources .env without exporting.

PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=lunet_dav
PGUSER=postgres
PGPASSWORD=postgres

JWT_SECRET=e2e-only-secret-not-for-production-use

LUNET_HOST=127.0.0.1
LUNET_PORT=18081

DAV_INSTANCE_ID=oczn5x60nrdu
DAV_FILEID_PAD_WIDTH=8

# Local MinIO from the compose stack
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=lunet-dav
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_LANDING_PREFIX=_landing/
S3_API_PROFILE=lcd
