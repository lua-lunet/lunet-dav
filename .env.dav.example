# lunet-dav configuration (copy to .env alongside the chassis PG vars)
#
# PostgreSQL (metadata) — same driver/vars as the chassis
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lunet_dav
PGUSER=postgres
PGPASSWORD=change-me
# PGSSLMODE=require   # set for TLS-mandatory databases (e.g. Scaleway managed PG)

# --- Network posture -------------------------------------------------------
# Loopback while testing (see docs/DESIGN.md §7). Front with nginx/OpenResty.
LUNET_HOST=127.0.0.1
LUNET_PORT=8081

# --- nc identity -----------------------------------------------------------
# Instance-id suffix of OC-FileId (<padded-id><instance-id>). Stable per instance.
DAV_INSTANCE_ID=oczn5x60nrdu
# Zero-pad width of the numeric OC-FileId portion (nc uses 8).
DAV_FILEID_PAD_WIDTH=8

# --- S3 object store -------------------------------------------------------
# Local testing: MinIO. Production: Scaleway (MinIO Enterprise) / AWS / SAN gateway.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=lunet-dav
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_LANDING_PREFIX=_landing/

# Bucket versioning is MANDATORY. Startup asserts GetBucketVersioning == Enabled
# and refuses to run otherwise. Not configurable.

# API feature profile (LCD mode). See docs/DESIGN.md §6.
#   lcd          -> only universally supported classic S3 ops (default; safest)
#   minio-latest -> may use newer MinIO-stable features
S3_API_PROFILE=lcd
