# lunet-dav configuration (copy to .env alongside the chassis PG vars)
#
# PostgreSQL (metadata) — same driver/vars as the chassis
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lunet_dav
PGUSER=postgres
PGPASSWORD=change-me
# PGSSLMODE=require   # set for TLS-mandatory databases (e.g. Scaleway managed PG)

# --- Network posture -------------------------------------------------------
# Loopback while testing (see docs/DESIGN.md §7). Front with nginx/OpenResty.
LUNET_HOST=127.0.0.1
LUNET_PORT=8081

# --- nc identity -----------------------------------------------------------
# Instance-id suffix of OC-FileId (<padded-id><instance-id>). Stable per instance.
DAV_INSTANCE_ID=oczn5x60nrdu
# Zero-pad width of the numeric OC-FileId portion (nc uses 8).
DAV_FILEID_PAD_WIDTH=8

# --- S3 object store -------------------------------------------------------
# Local testing: MinIO. Production: Scaleway (MinIO Enterprise) / AWS / SAN gateway.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=lunet-dav
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_LANDING_PREFIX=_landing/

# Bucket versioning is MANDATORY. Startup asserts GetBucketVersioning == Enabled
# and refuses to run otherwise. Not configurable.

# --- Behavior configuration ------------------------------------------------
# Layered: Lua defaults in app/behavior.lua < this file < real env vars.
# Defaults reproduce the v0.1.0 wire contract exactly (docs/DESIGN.md §7-§8).

# Upstream capability profile (docs/DESIGN.md §6):
#   lcd                                  -> classic SigV4 ops only (default; safest)
#   minio | minio-enterprise             -> + x-amz-checksum-sha256 on PUT (upstream
#                                            verifies the transfer), checksum harvest
S3_API_PROFILE=lcd

# When X-Hash-SHA256 appears on PUT responses:
#   on-request (default) | always | never
DAV_EMIT_HASH_HEADER=on-request

# Upstream response headers copied verbatim onto PUT responses (comma-separated,
# default empty = leak nothing upstream). Only headers actually harvested under the
# active profile are copied; others are silently skipped.
# DAV_PUT_PASSTHROUGH_HEADERS=x-amz-version-id,x-amz-checksum-sha256
